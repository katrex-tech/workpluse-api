# ==============================================================================
# CompreFace Environment Variables Configuration
# ==============================================================================

# PostgreSQL internal database credentials
POSTGRES_USER=compreface
POSTGRES_PASSWORD=compreface_secure_password_123!
POSTGRES_DB=compreface

# CompreFace UI and Port
CLIENT_MAX_BODY_SIZE=10M
PROXY_READ_TIMEOUT=60000
PROXY_CONNECT_TIMEOUT=10000
MAX_FILE_SIZE=10MB

# Save uploaded images to DB (false = only face embeddings saved for privacy)
SAVE_IMAGES_TO_DB=false
ENABLE_EMAIL_VERIFICATION=false
